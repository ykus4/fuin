# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# -----------------------------------------------------------------------
# Server auth (required)
# -----------------------------------------------------------------------
FUIN_API_KEY=your-secret-api-key-here

# -----------------------------------------------------------------------
# Signing keystore (optional)
# If not set, a temporary debug keystore is generated automatically.
# Use a real keystore for production / release builds.
# -----------------------------------------------------------------------
# FUIN_KEYSTORE_PATH=/path/to/release.keystore
# FUIN_KEYSTORE_ALIAS=fuin
# FUIN_KEYSTORE_STORE_PASS=your-store-password
# FUIN_KEYSTORE_KEY_PASS=your-key-password

# -----------------------------------------------------------------------
# Storage (optional — defaults shown)
# -----------------------------------------------------------------------
# FUIN_PACKED_DIR=./data/packed_apks
# FUIN_DATABASE_URL=sqlite:///./data/fuin.db

# -----------------------------------------------------------------------
# Upload limits (optional)
# -----------------------------------------------------------------------
# FUIN_MAX_UPLOAD_MB=500

# -----------------------------------------------------------------------
# Auto-cleanup (optional)
# Delete packed APKs and DB records older than N days (0 = disabled)
# -----------------------------------------------------------------------
# FUIN_CLEANUP_DAYS=30

# -----------------------------------------------------------------------
# Webhook (optional)
# POST to this URL when a pack job completes.
# Targets must be https and resolve to a public address; private, loopback and
# link-local addresses are refused so a webhook URL cannot be used to reach
# into the deployment network.
# -----------------------------------------------------------------------
# FUIN_WEBHOOK_URL=https://hooks.slack.com/services/...
# Allow plain http webhooks as well. Off by default — the payload carries the
# package name and the pack report.
# FUIN_WEBHOOK_ALLOW_HTTP=false

# -----------------------------------------------------------------------
# Packing defaults (optional)
# Each is a default only: an explicit value on the CLI or the REST API wins.
# -----------------------------------------------------------------------
# Fail the pack if AndroidManifest.xml could not be pointed at the stub.
# FUIN_STRICT_MANIFEST_PATCH=true
# Run `apksigner verify` on the output. Requires Android build-tools.
# FUIN_VERIFY_SIGNATURE=false
# Runtime checks compiled into the security policy asset.
# FUIN_ROOT_DETECTION=false
# FUIN_EMULATOR_DETECTION=false
# XOR the DEX data section at pack time, undone by the stub at launch.
# FUIN_ENCRYPT_STRINGS=false
# Use a stub DEX other than the one bundled in the wheel.
# FUIN_STUB_DEX=/path/to/stub.dex

# -----------------------------------------------------------------------
# ProGuard mapping upload limit (optional)
# -----------------------------------------------------------------------
# FUIN_MAX_MAPPING_MB=50
